{
  "name": "signalforge",
  "version": "0.1.0",
  "description": "Local-first MCP prompt intent compiler for Codex, Claude Code, Cursor, and generic LLM workflows.",
  "type": "module",
  "bin": {
    "signalforge": "./dist/cli.js",
    "signalforge-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:cli": "tsx src/cli.ts",
    "dev:mcp": "tsx src/stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node dist/cli.js compile \"build me a portfolio app\" --target codex",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js"
  },
  "keywords": [
    "mcp",
    "prompt-engineering",
    "codex",
    "claude-code",
    "prompt-compiler",
    "model-context-protocol"
  ],
  "author": "Karthikey G",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
